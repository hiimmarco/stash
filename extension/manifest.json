{
  "manifest_version": 3,
  "name": "Save to Stash",
  "version": "1.0.0",
  "description": "Save the current tab to your Stash with one click.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Save to Stash",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*/*"
  ]
}
